{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "./output",
    "outDir": "./output",
    "emitDeclarationOnly": true,
    "noCheck": true
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "output",
    "example",
    "src/**/__tests__/**",
    "src/**/*.test.*",
    "src/**/__mocks__/**"
  ]
}
