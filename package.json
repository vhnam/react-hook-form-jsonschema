    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jest": "^28.11.0",
    "globals": "^17.6.0",
    "jest": "^30.4.1",
    "jest-environment-jsdom": "^30.4.1",
    "lefthook": "^2.1.6",
